# Copy to .env and fill in. Never commit .env.
# Optional: free key from https://openchargemap.org/site/develop/api (without it the open OCM export is used)
OCM_API_KEY=
# Supabase project URL and the PUBLIC anon key only (Project settings -> API). Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-side only (Vercel env vars, used by middleware.ts for /admin). Not exposed to the browser.
ADMIN_USER=
ADMIN_PASSWORD=
# Only for scripts/backup-db.mjs, run on your own machine. Keep in .env.local, never in Vercel/browser code.
SUPABASE_SERVICE_ROLE_KEY=
