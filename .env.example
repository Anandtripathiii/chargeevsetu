# Copy to .env and fill in. Never commit .env.
# Optional: free key from https://openchargemap.org/site/develop/api (without it the open OCM export is used)
OCM_API_KEY=
# Supabase project URL and the PUBLISHABLE key (Project settings -> API Keys: sb_publishable_...). A legacy anon JWT also works.
# Never put a secret key here: VITE_* values ship to every browser, and the build fails if this holds an sb_secret_ / service_role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Server-side only (Vercel env vars, used by middleware.ts for /admin). Not exposed to the browser.
ADMIN_USER=
ADMIN_PASSWORD=
# SECRET key (sb_secret_..., or a legacy service_role JWT). Server/local only: scripts/backup-db.mjs, scripts/security-tests.mjs
# (keep in .env.local) and, optionally, the Vercel admin API / middleware as a non-VITE env var. Never in browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Cloudflare Turnstile site key (public). Also paste the SECRET key in Supabase -> Authentication -> Attack Protection.
VITE_TURNSTILE_SITE_KEY=
# Optional, server-only (Vercel): shared admin lockout counter across edge instances
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
