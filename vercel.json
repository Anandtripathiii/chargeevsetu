{
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/((?!assets/|data/).*)", "destination": "/admin/index.html" },
    { "source": "/((?!data/|assets/|admin/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/admin/(.*)", "headers": [{ "key": "Cache-Control", "value": "private, no-store" }, { "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
